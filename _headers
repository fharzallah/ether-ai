# En-tetes de securite des fichiers statiques (Cloudflare Workers Static Assets).
# L'API (/api/*) est servie par le worker et n'est pas concernee.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://image.pollinations.ai https://*.wikipedia.org https://*.wikimedia.org https://mistral.ai; connect-src 'self'; media-src 'self' blob:; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), geolocation=(), microphone=(self)

# Le service worker doit etre revalide a chaque visite, sinon une mise a jour
# de l'app peut rester bloquee chez l'utilisateur.
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Content-Type: application/manifest+json
