# Copie ce fichier vers .env.local (ignoré par git), puis remplace les valeurs.

# Adresse de l'app ETHER, sans / final. Le bouton « Essayer ETHER » y mène.
VITE_APP_URL=https://ton-instance.example

# Code d'invitation ajouté au lien (?code=...). Laisse vide si l'instance est ouverte.
VITE_INVITE_CODE=CODE

# Adresse publique de cette page, sans / final : canonical, hreflang et image Open Graph.
VITE_SITE_URL=https://ton-site.example
