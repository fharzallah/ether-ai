# Copier en worker/.dev.vars (ignore par git) pour le developpement local.
# En production, chaque valeur se pose avec : npx wrangler secret put NOM

# Fournisseurs IA — au moins un. OpenRouter a un palier gratuit sans carte.
GROQ_KEY=your_groq_key_here
GEMINI_KEY=your_gemini_key_here
MISTRAL_KEY=your_mistral_key_here
OPENROUTER_KEY=your_openrouter_key_here
CEREBRAS_KEY=your_cerebras_key_here

# Recherche web (optionnel). Sans cle : Wikipedia + DuckDuckGo.
# Tavily (tvly-...), Brave (BSA...) ou Serper, detecte automatiquement.
SEARCH_KEY=

# Sans JWT_SECRET, verifyAuth laisse tout passer (pratique en local, jamais en prod).
JWT_SECRET=change_me_to_a_random_secret

# Code d'invitation (optionnel). Vide = inscription ouverte.
# Le lien a partager devient https://ton-worker.workers.dev/?code=CE_CODE
INVITE_CODE=
